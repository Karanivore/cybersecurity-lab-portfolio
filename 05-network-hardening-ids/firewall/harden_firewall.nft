#!/usr/sbin/nft -f
#
# nftables hardening ruleset implementing the segmentation design in
# ../network_segmentation_diagram.md: default-deny at every boundary,
# explicit allow-lists per VLAN, and logging of all drops for SIEM
# ingestion (feeds the detection engine built in Lab 2).
#
# Usage:
#   sudo nft -f harden_firewall.nft          # apply
#   nft -c -f harden_firewall.nft            # syntax-check only (no apply)
#
# Interfaces/VLANs assumed (adjust to your environment):
#   eth0        = WAN / uplink
#   vlan10.dmz  = DMZ            10.10.10.0/24
#   vlan20.int  = Internal       10.10.20.0/24
#   vlan30.mgmt = Management     10.10.30.0/24
#   vlan40.sec  = Security/SIEM  10.10.40.0/24

flush ruleset

table inet filter {

    set dmz_web_servers {
        type ipv4_addr
        elements = { 10.10.10.10, 10.10.10.11 }
    }

    set internal_db_servers {
        type ipv4_addr
        elements = { 10.10.20.50 }
    }

    chain inbound {
        type filter hook input priority 0; policy drop;

        iif lo accept
        ct state established,related accept
        ct state invalid drop

        # Perimeter: only 443/80 to DMZ web servers, 25/587 to mail gateway
        iif "eth0" ip daddr @dmz_web_servers tcp dport { 80, 443 } accept
        iif "eth0" ip daddr 10.10.10.20 tcp dport { 25, 587 } accept

        # Management VLAN only reachable from the bastion/jump host, MFA-gated upstream
        ip saddr 10.10.30.5 ip daddr 10.10.30.0/24 tcp dport { 22, 3389 } accept

        # ICMP echo for operational diagnostics, rate-limited
        ip protocol icmp icmp type echo-request limit rate 5/second accept

        # Everything else: log then drop (feeds SIEM port-scan / recon detection)
        log prefix "nft-inbound-drop: " level info
        drop
    }

    chain forward {
        type filter hook forward priority 0; policy drop;

        ct state established,related accept
        ct state invalid drop

        # DMZ -> Internal: deny by default, EXCEPT app -> DB on the specific port
        ip saddr 10.10.10.0/24 ip daddr @internal_db_servers tcp dport 5432 accept
        ip saddr 10.10.10.0/24 ip daddr 10.10.20.0/24 drop comment "no other DMZ->Internal paths"

        # Internal -> DMZ web tier (users hitting the internal app front end)
        ip saddr 10.10.20.0/24 ip daddr @dmz_web_servers tcp dport 443 accept

        # Internal workstations -> jump host only (not directly to Management VLAN)
        ip saddr 10.10.20.0/24 ip daddr 10.10.30.5 tcp dport { 22, 3389 } accept
        ip saddr 10.10.20.0/24 ip daddr 10.10.30.0/24 drop comment "workstations cannot bypass the jump host"

        # All VLANs -> Security VLAN: allow only mirrored/tap traffic direction (no inbound to VLAN 40)
        ip daddr 10.10.40.0/24 drop comment "security VLAN is receive-only via port mirroring, not routed traffic"

        # Outbound internet from Internal via explicit proxy only
        ip saddr 10.10.20.0/24 oif "eth0" tcp dport { 80, 443 } ip daddr != 10.10.0.0/16 accept

        log prefix "nft-forward-drop: " level info
        drop
    }

    chain output {
        type filter hook output priority 0; policy accept;
    }
}
